  (text "MAINS 230 VAC  -  DANGER" (at 25.4 30.48 0)
    (effects (font (size 2.5 2.5)) (justify left))
    (uuid 8deb3c28-2b09-418a-b602-269aee870def)
  )
  (text "K1 contact switches only the contactor coil (A1/A2).\nHeater load goes through the contactor, never through K1."
    (at 152.4 91.44 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 4ceafcab-46a0-49fd-9e4c-bd6ba0bb3bcf)
  )
  (text "POWER  5 V -> 3.3 V" (at 25.4 116.84 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid cd720500-7440-414a-9282-2f2e1a0f1540)
  )
  (text "RELAY DRIVER" (at 25.4 177.8 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid e9c57bd9-0397-4ee6-b209-971957f4ff3b)
  )
  (text "R4 holds the relay OFF while the ESP32 boots or resets."
    (at 25.4 228.6 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid da4fb430-b8fa-4495-a5d6-d3576756b2e8)
  )
  (text "ESP32 + UI" (at 304.8 30.48 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid d4737f0c-2301-4e43-9093-bf74986e87c6)
  )
  (text "J3: connect a 3.3 V USB-UART adapter with MAINS DISCONNECTED.\nHold BOOT, tap RESET to flash. Later updates over WiFi (OTA).\nSW2 doubles as a manual 'boost' button after boot.\nJ3 pins: 1=3V3 2=GND 3=TXD0 4=RXD0 5=EN 6=IO0.  J4 (optional): 1=3V3 2=DATA 3=GND."
    (at 152.4 254.0 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 4b383550-4fc8-4b16-825c-2555eef9b100)
  )

